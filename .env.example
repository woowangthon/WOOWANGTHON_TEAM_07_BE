# 복사해서 .env로 만든 뒤 값을 채워 쓴다. .env는 커밋하지 않는다.
DATABASE_URL=sqlite:///./data/dev.db
SEOUL_OPEN_API_KEY=
# 엘리베이터 상태 TTL(분, 1~1440). 비우면 기본 120분. 갱신 주기 미검증에 따른 임시 기본값이다.
# ELEVATOR_STATUS_TTL_MINUTES=120
# 출발 권장 시각 계산의 추정 기본값(분, 0~120). 검증되지 않은 추정값이다.
# WALK_TO_STATION_MINUTES=7
# STATION_ENTRY_MINUTES=3
# EXIT_WALK_MINUTES=3
# 경로 탐색 가중치(분). 검증되지 않은 추정값이다.
# ROUTE_SEGMENT_MINUTES=2
# ROUTE_TRANSFER_MINUTES=5
# FE 호출을 허용할 Origin(쉼표 구분, 와일드카드 불가). 비우면 교차 출처를 허용하지 않는다.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# 실시간 도착 캐시 보관 시간(초, 1~300). 기본 30.
# ARRIVAL_CACHE_TTL_SECONDS=30
