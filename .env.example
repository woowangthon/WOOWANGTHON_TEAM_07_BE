# 복사해서 .env로 만든 뒤 값을 채워 쓴다. .env는 커밋하지 않는다.
DATABASE_URL=sqlite:///./data/dev.db
SEOUL_OPEN_API_KEY=
# 엘리베이터 상태 TTL(분, 1~1440). 비우면 기본 120분. 갱신 주기 미검증에 따른 임시 기본값이다.
# ELEVATOR_STATUS_TTL_MINUTES=120
# 출발 권장 시각 계산의 추정 기본값(분, 0~120). 검증되지 않은 추정값이다.
# WALK_TO_STATION_MINUTES=7
# STATION_ENTRY_MINUTES=3
# EXIT_WALK_MINUTES=3
